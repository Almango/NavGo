---
// 导航栏组件
import { Icon } from "astro-icon/components";
---

<!-- 顶部导航栏 -->
<header class="top-nav">
    <a href="/" class="logo-link">
        <img src="/favicon.ico" alt="Logo" class="logo-icon" />
        <span>NavGo</span>
    </a>
    <button class="menu-toggle" aria-label="Toggle menu">
        <Icon name="mdi:view-agenda-outline" class="menu-icon" />
    </button>
</header>

<style>
    /* 确保顶部导航栏在移动端显示 */
    @media (max-width: 768px) {
        .top-nav {
            display: flex !important;
        }
        
        .menu-toggle {
            display: flex !important;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
        }
        
        .menu-icon {
            font-size: 24px;
            color: var(--text-color);
        }
    }
</style>

<!-- 侧边导航栏 -->
<aside class="sidebar">
    <div class="sidebar-header">
        <a href="/" class="logo-link">
            <img src="/favicon.ico" alt="Logo" class="sidebar-logo-icon" />
            <h2>NavGo</h2>
        </a>
    </div>
    <ul class="nav-menu">
        <li><a href="/">
            <Icon name="mdi:compass-outline" class="nav-item-icon" />
            <span>导航中心</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:briefcase-variant-outline" class="nav-item-icon" />
            <span>办公专题</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:puzzle-outline" class="nav-item-icon" />
            <span>娱乐专区</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:robot-outline" class="nav-item-icon" />
            <span>人工智能</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:square-root" class="nav-item-icon" />
            <span>学术支持</span>
        </a></li>
        <br>
        <li><a href="/anime">
            <Icon name="mdi:play-box-outline" class="nav-item-icon" />
            <span>番剧</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:gamepad-round-outline" class="nav-item-icon" />
            <span>游戏</span>
        </a></li>
        <li><a href="/">
            <Icon name="mdi:cards-club-outline" class="nav-item-icon" />
            <span>漫画</span>
        </a></li>
        <li><a href="/about">
            <Icon name="mdi:alert-circle-outline" class="nav-item-icon" />
            <span>关于</span>
        </a></li>

    </ul>
</aside>

<!-- 遮罩层 -->
<div class="sidebar-overlay"></div>

<script>
    const menuToggle = document.querySelector('.menu-toggle');
    const sidebar = document.querySelector('.sidebar');
    const overlay = document.querySelector('.sidebar-overlay');
    
    menuToggle.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        overlay.classList.toggle('active');
    });
    
    overlay.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
    });
</script>