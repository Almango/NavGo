---
// 番剧页面 - 使用Bangumi API获取用户收藏
import { API } from '../config';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Icon } from "astro-icon/components";
import '../assets/css/style.css';

const username = API.BangumiAPI_ID;
let collections = [];
let loading = true;
let error = null;

try {
    const response = await fetch(`https://api.bgm.tv/v0/users/${username}/collections?subject_type=2&limit=50`, {
        headers: {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36 Edg/144.0.0.0',
            'Accept': 'application/json'
        }
    });
    
    if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
    }
    
    const data = await response.json();
    collections = data.data || data || [];
    loading = false;
} catch (err) {
    console.error('获取Bangumi数据失败:', err);
    error = err.message;
    loading = false;
}
---

<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NavGo - 番剧收藏</title>
</head>
<body>
    <div class="container">
        <!-- 左侧导航栏 -->
        <Navbar />
        
        <!-- 内容区域 -->
        <main class="content">
                <div class="anime-header">
                    <h2 class="anime-title">番剧收藏</h2>
                    <p class="anime-subtitle">由<a href="https://bgm.tv/" target="_blank">Bangumi API</a>提供数据支持</p>
                </div>
                
                {loading && (
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <p>加载中...</p>
                    </div>
                )}
                
                {error && (
                    <div class="error-container">
                        <Icon name="mdi:alert-circle-outline" class="error-icon" />
                        <p class="error-message">加载失败: {error}</p>
                        <p class="error-hint">请检查网络连接或稍后重试</p>
                    </div>
                )}
                
                {!loading && !error && collections.length > 0 && (
                    <div class="anime-grid animate-slide-in">
                        {collections.map((collection) => {
                            // 调试：输出数据结构
                            console.log('Collection data:', collection);
                            
                            // 尝试不同的数据访问路径
                            const subject = collection.subject || collection;
                            const name = subject.name || subject.title || '未知番剧';
                            const images = subject.images || subject.image || {};
                            const cover = images.large || images.medium || images.small;
                            const rating = subject.rating?.score || subject.score || 'N/A';
                            const tags = subject.tags || subject.genres || [];
                            const isWatching = collection.status === 'watching' || false;
                            const subjectId = collection.subject_id || subject.id || 0;
                            // 提取年份
                            const date = subject.date || subject.air_date || '';
                            const year = date ? date.split('-')[0] : '';
                            
                            return (
                                <a href={`https://bgm.tv/subject/${subjectId}`} target="_blank" class="anime-card-link">
                                    <div class="anime-card">
                                        <div class="anime-cover">
                                            {cover ? (
                                                <img src={cover} alt={name} />
                                            ) : (
                                                <div class="anime-cover-placeholder">
                                                    <Icon name="mdi:image-outline" class="placeholder-icon" />
                                                </div>
                                            )}
                                        </div>
                                        <div class="anime-info">
                                            <div class="anime-title-row">
                                                <h3 class="anime-title">{name}</h3>
                                                {isWatching && (
                                                    <span class="watching-badge">
                                                        <Icon name="mdi:play-circle-outline" class="watching-icon" />
                                                        追看中
                                                    </span>
                                                )}
                                            </div>
                                            {tags.length > 0 && (
                                                <div class="anime-tags">
                                                    {tags.slice(0, 3).map((tag, index) => {
                                                        const tagName = typeof tag === 'object' ? tag.name || tag : tag;
                                                        return tagName ? (
                                                            <span key={index} class="anime-tag">{tagName}</span>
                                                        ) : null;
                                                    })}
                                                </div>
                                            )}
                                            <div class="anime-meta">
                                                <div class="anime-rating">
                                                    <Icon name="mdi:star" class="rating-icon" />
                                                    {rating}
                                                </div>
                                                {year && (
                                                    <div class="anime-year">
                                                        {year}
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                )}
                
                {!loading && !error && collections.length === 0 && (
                    <div class="empty-container">
                        <Icon name="mdi:book-open-outline" class="empty-icon" />
                        <p class="empty-message">暂无收藏番剧</p>
                        <p class="empty-hint">去Bangumi添加一些收藏吧！</p>
                    </div>
                )}
            
            <Footer />
        </main>
    </div>
</body>
</html>

<style>
    /* 番剧头部样式 */
    .anime-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        padding: 20px 0;
        border-bottom: 1px solid #eee;
    }
    
    .anime-title {
        font-size: 32px;
        font-weight: bold;
        color: var(--text-color);
        margin: 0;
    }
    
    .anime-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 0;
    }
    .anime-subtitle a {
        color: var(--text-a);
        text-decoration: none;
    }
    
    /* 加载状态样式 */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }
    
    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid var(--text-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .loading-container p {
        font-size: 16px;
        color: var(--text-secondary);
        margin: 0;
    }
    
    /* 错误状态样式 */
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
    }
    
    .error-icon {
        font-size: 64px;
        color: #e74c3c;
        margin-bottom: 20px;
    }
    
    .error-message {
        font-size: 18px;
        color: var(--text-color);
        margin: 0 0 10px 0;
        font-weight: 500;
    }
    
    .error-hint {
        font-size: 14px;
        color: var(--text-secondary);
        margin: 0;
    }
    
    /* 空状态样式 */
    .empty-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
    }
    
    .empty-icon {
        font-size: 64px;
        color: #ccc;
        margin-bottom: 20px;
    }
    
    .empty-message {
        font-size: 18px;
        color: var(--text-color);
        margin: 0 0 10px 0;
        font-weight: 500;
    }
    
    .empty-hint {
        font-size: 14px;
        color: var(--text-secondary);
        margin: 0;
    }
    
    /* 番剧网格布局 */
    .anime-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 40px;
    }
    
    /* 平板设备响应式设计 */
    @media (min-width: 769px) and (max-width: 1024px) {
        .anime-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 14px;
        }
    }
    
    /* 番剧卡片链接 */
    .anime-card-link {
        text-decoration: none;
        color: inherit;
        transition: transform 0.3s ease;
    }
    
    .anime-card-link:hover {
        transform: translateY(-3px);
    }
    
    /* 番剧卡片样式 */
    .anime-card {
        background-color: var(--card-color);
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--box-shadow);
        transition: box-shadow 0.3s ease;
    }
    
    .anime-card:hover {
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
    }
    
    /* 番剧封面样式 */
    .anime-cover {
        width: 100%;
        height: 0;
        padding-bottom: 140%;
        background-color: #f5f5f5;
        overflow: hidden;
        position: relative;
    }
    
    .anime-cover img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    
    .anime-card:hover .anime-cover img {
        transform: scale(1.05);
    }
    
    .placeholder-icon {
        font-size: 32px;
        color: #ccc;
    }
    
    /* 番剧信息样式 */
    .anime-info {
        padding: 12px;
    }
    
    .anime-title {
        font-size: 18px;
        font-weight: 500;
        color: var(--text-color);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    /* 标题行样式 */
    .anime-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }
    
    /* 追看中徽章样式 */
    .watching-badge {
        display: flex;
        align-items: center;
        gap: 2px;
        font-size: 10px;
        color: #3498db;
        background-color: #e3f2fd;
        padding: 2px 6px;
        border-radius: 4px;
    }
    
    .watching-icon {
        font-size: 12px;
    }
    
    /* 番剧元数据样式 */
    .anime-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 8px;
    }
    
    /* 番剧评分样式 */
    .anime-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 18px;
        color: #f39c12;
        font-weight: 500;
    }
    
    .rating-icon {
        font-size: 18px;
    }
    
    /* 番剧年份样式 */
    .anime-year {
        font-size: 11px;
        color: var(--text-secondary);
        padding: 6px 0px 0px 0px;
    }
    
    /* 番剧标签样式 */
    .anime-tags {
        display: flex;
        gap: 4px;
        margin-top: 6px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .anime-tag {
        font-size: 10px;
        color: var(--text-secondary);
        background-color: #f0f0f0;
        padding: 2px 6px;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    
    /* 响应式设计 */
    @media (max-width: 768px) {

        .anime-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 12px;
        }
        .anime-info {
            padding: 10px;
        }


    }
</style>
