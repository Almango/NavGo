---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Icon } from "astro-icon/components";
import '../assets/css/style.css';
import albumData from '../assets/data/album.json';

const categories = albumData.categories;
const photos = albumData.photos;
---

<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>图册 - NavGo</title>
</head>
<body>
    <div class="container">
        <Navbar />
        
        <main class="content">
            <div class="album-header">
                <h1 class="album-title">图册</h1>
                <p class="album-subtitle">记录生活中的美好瞬间</p>
            </div>
            
            <div class="category-filter">
                <button class="category-btn active" data-category="all">
                    <Icon name="mdi:image-multiple-outline" class="category-icon" />
                    <span>全部</span>
                </button>
                {categories.map(category => (
                    <button class="category-btn" data-category={category.id}>
                        <Icon name={category.icon} class="category-icon" />
                        <span>{category.name}</span>
                    </button>
                ))}
            </div>
            
            <div class="waterfall-grid" id="photoGrid">
                {photos.map(photo => (
                    <div class="photo-card" data-category={photo.category}>
                        <div class="photo-image">
                            <img src={photo.image} alt={photo.description} loading="lazy" />
                        </div>
                        <div class="photo-info">
                            <div class="photo-meta">
                                <span class="photo-category">
                                    <Icon name="mdi:folder-outline" class="meta-icon" />
                                    {categories.find(c => c.id === photo.category)?.name || '未分类'}
                                </span>
                                <span class="photo-location">
                                    <Icon name="mdi:map-marker-outline" class="meta-icon" />
                                    {photo.location}
                                </span>
                            </div>
                            <div class="photo-date">
                                <Icon name="mdi:calendar-outline" class="meta-icon" />
                                {photo.date}
                            </div>
                            <p class="photo-description">{photo.description}</p>
                        </div>
                    </div>
                ))}
            </div>
            
            <Footer />
        </main>
    </div>
</body>
</html>

<style>
    .album-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }
    
    .album-title {
        font-size: 32px;
        font-weight: bold;
        color: var(--text-color);
        margin: 0;
    }
    
    .album-subtitle {
        font-size: 14px;
        color: var(--text-secondary);
        margin: 0;
    }
    
    .category-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 30px;
    }
    
    .category-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background-color: var(--card-color);
        border: 1px solid #e0e0e0;
        border-radius: 20px;
        font-size: 14px;
        color: var(--text-color);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .category-btn:hover {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }
    
    .category-btn.active {
        background-color: var(--text-color);
        color: white;
        border-color: var(--text-color);
    }
    
    .category-btn.active .category-icon {
        color: white;
    }
    
    .category-icon {
        font-size: 18px;
        color: var(--text-secondary);
    }
    
    .waterfall-grid {
        column-count: 4;
        column-gap: 16px;
        margin-bottom: 40px;
    }
    
    .photo-card {
        position: relative;
        break-inside: avoid;
        margin-bottom: 16px;
        background-color: var(--card-color);
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--box-shadow);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .photo-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
    }
    
    .photo-image {
        width: 100%;
        overflow: hidden;
    }
    
    .photo-image img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
    }
    
    .photo-card:hover .photo-image img {
        transform: scale(1.05);
    }
    
    .photo-info {
        padding: 12px;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        color: white;
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }
    
    .photo-card:hover .photo-info {
        transform: translateY(0);
    }
    
    .photo-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
    }
    
    .photo-category,
    .photo-location {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: rgba(255,255,255,0.8);
    }
    
    .photo-date {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: rgba(255,255,255,0.8);
        margin-bottom: 8px;
    }
    
    .meta-icon {
        font-size: 14px;
        color: rgba(255,255,255,0.8);
    }
    
    .photo-description {
        font-size: 14px;
        color: white;
        margin: 0;
        line-height: 1.5;
    }
    

    
    @media (max-width: 1200px) {
        .waterfall-grid {
            column-count: 3;
        }
    }
    
    @media (max-width: 768px) {
        .album-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .album-title {
            font-size: 24px;
            margin-bottom: 8px;
        }
        
        .category-filter {
            gap: 8px;
        }
        
        .category-btn {
            padding: 6px 12px;
            font-size: 13px;
        }
        
        .waterfall-grid {
            column-count: 2;
            column-gap: 12px;
        }
        
        .photo-card {
            margin-bottom: 12px;
        }
        
        .photo-info {
            padding: 10px;
        }
    }
</style>

<script>
    const categoryBtns = document.querySelectorAll('.category-btn');
    const photoCards = document.querySelectorAll('.photo-card');
    
    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            categoryBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            const category = btn.getAttribute('data-category');
            
            photoCards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
