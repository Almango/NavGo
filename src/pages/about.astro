---
// 关于页面
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Icon } from "astro-icon/components";
import '../assets/css/style.css';
---

<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NavGo - 关于</title>
</head>
<body>
    <div class="container">
        <!-- 左侧导航栏 -->
        <Navbar />
        
        <!-- 内容区域 -->
        <main class="content">
            <div class="about-container">
                <div class="about-header">
                    <!-- 与侧边栏logo名称布局一致 -->
                    <div class="sidebar-header">
                        <img src="/favicon.ico" alt="Logo" class="sidebar-logo-icon" />
                        <h2>NavGo</h2>
                    </div>
                </div>
                
                <div class="about-content">
                    <section class="about-section">
                        <h2 class="section-title">关于我们</h2>
                        <p class="section-text">
                            NavGo是一个由个人运营的简约而实用的导航网站，这里收录了个人常用以及好用的在线网站和媒体信息，涵盖了办公、娱乐、学习等领域，其宗旨是以简洁干净的风格理念打造一个高效而便捷的导航平台，提高办公效率，让网络冲浪更加轻松愉快。
                            
                        </p>
                        <p class="section-text">
                        如果你对本站主题感兴趣，可前往<a href="https://github.com/Almango/NavGo" target="_blank" class="contact-link"> 代码仓库 </a>预览和使用。 
                        </p>
                    </section>
                    
                    <section class="about-section">
                        <h2 class="section-title">联系我们</h2>
                        <p class="section-text">
                            如果您有任何建议或意见，欢迎联系我。
                        </p>
                        <div class="contact-info">
                            <p class="contact-item">
                                <span>邮箱：sliveralmango@outlook.com</span>
                            </p>
                        </div>
                    </section>
                    
                    <section class="about-section">
                        <h2 class="section-title">免责声明</h2>
                        <p class="section-text">
                            本站资源来源第三方或互联网，若侵犯您的合法权益，请联系我，我将第一时间处理。本站仅提供导航服务，不对链接网站的内容负责。使用本站资源即表示您同意本免责声明。
                        </p>
                    </section>
                </div>
            </div>
            
            <Footer />
        </main>
    </div>
</body>
</html>

<style>
    /* 全局样式 */
    :root {
        --primary-color: #f5f7fa;
        --secondary-color: #ffffff;
        --text-color: #333333;
        --text-secondary: #666666;
        --accent-color: #3498db;
        --border-radius: 8px;
        --transition: all 0.3s ease;
    }
    
    /* 容器样式 */
    .about-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px 0px;
    }
    
    /* 头部样式 */
    .about-header {
        margin-bottom: 50px;
        padding: 0;
    }
    
    /* 使用侧边栏的logo名称布局样式 */
    .sidebar-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 auto;
        padding: 0;
        justify-content: center;
    }
    
    .sidebar-logo-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        object-fit: cover;
    }
    
    .sidebar-header h2 {
        margin: 0;
        font-size: 25px;
        font-weight: bold;
        color: var(--text-color);
    }
    
    /* 内容区域样式 */
    .about-content {
        margin-bottom: 40px;
    }
    
    .about-section {
        margin-bottom: 32px;
        padding: 0;
    }
    
    .section-title {
        font-size: 18px;
        font-weight: 500;
        color: var(--text-color);
        margin: 0 0 16px 0;
    }
    
    .section-text {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 16px 0;
    }
    
    /* 联系信息样式 */
    .contact-info {
        margin-top: 16px;
    }
    
    .contact-item {
        font-size: 16px;
        color: var(--text-secondary);
        margin: 0 0 8px 0;
    }
    
    .contact-link {
        color: var(--text-a);
        text-decoration: none;
    }
    
    /* 响应式设计 */
    @media (max-width: 768px) {
        .about-header {
            margin-bottom: 32px;
        }
        
        .about-section {
            margin-bottom: 24px;
        }
        
        .section-title {
            font-size: 18px;
        }
    }
</style>
